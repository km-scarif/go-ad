# Copy to .env.test (gitignored) and point it at a directory you are allowed to
# WRITE to. The live tests create and delete objects.
#
#   cp .env.test.example .env.test
#   just test-live

AD_TEST_URL=ldaps://127.0.0.1:636
AD_TEST_BIND_DN="CN=Administrator,CN=Users,DC=example,DC=com"
AD_TEST_BIND_PW="change-me"
AD_TEST_BASE_DN=DC=example,DC=com
AD_TEST_UPN_SUFFIX=example.com

# Set against a directory with a self-signed certificate.
AD_TEST_SKIP_VERIFY=1

# Needed against Samba-based directories. Samba's auto-generated CA often draws
# a NEGATIVE serial number, and Go 1.23+ refuses to parse such a certificate at
# all. AD_TEST_SKIP_VERIFY does not help — that skips verification, and this
# fails earlier, at parsing. Because the serial is random, it is a coin flip on
# each fresh provision, so it presents as an intermittent outage.
GODEBUG=x509negativeserial=1
